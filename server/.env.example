# Copy this file to .env and fill in JWT_SECRET.
# Make a secret with:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
MONGODB_URI=mongodb://127.0.0.1:27017/ignite_app
JWT_SECRET=replace-with-a-long-random-string
PORT=4000

# Optional. Hindi and Marathi are filled in automatically (MyMemory) when a teacher saves English text.
# TRANSLATE=off                 turn that off
# TRANSLATE_EMAIL=you@school.in MyMemory allows far more text per day when it knows an email

# Deployed only. The exact address of the app (Vercel), no trailing slash. Several: separate with commas.
# CLIENT_ORIGIN=https://your-app.vercel.app
# NODE_ENV=production
